# Optional — the app runs against local Ollama with sensible defaults, so a .env
# is not required. Copy to .env only to override the model or endpoint.
#
# Pull a capable 7-8B instruct model first, e.g.:
#   ollama pull qwen2.5:7b     (default — strong at JSON/instructions)
#   ollama pull llama3.1:8b    (alternative)
#
# Ollama must be running:  OLLAMA_ORIGINS="*" ollama serve

VITE_OLLAMA_MODEL=qwen2.5:7b
VITE_OLLAMA_URL=http://localhost:11434/api/chat
